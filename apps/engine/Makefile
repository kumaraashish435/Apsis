# Developer convenience wrapper around CMake/Premake. Not autogenerated —
# Premake's own generated makefiles live under build/premake/ (see
# `location "build/premake"` in premake5.lua), so this name is free to use.
#
# Usage:
#   make               build with Premake (CONFIG=debug|release|dist, default debug)
#   make CONFIG=release
#   make cmake         build with CMake (CONFIG=Debug|Release|Dist, default Debug)
#   make clean         remove build/ entirely (both systems' output)

CONFIG ?= debug
CMAKE_CONFIG ?= Debug

.PHONY: all premake cmake clean

all: premake

premake:
	premake5 gmake2
	$(MAKE) -C build/premake config=$(CONFIG)

cmake:
	cmake -S . -B build -DCMAKE_BUILD_TYPE=$(CMAKE_CONFIG)
	cmake --build build

clean:
	rm -rf build
